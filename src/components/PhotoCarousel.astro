---
import type { ImageMetadata } from 'astro';
import { PORTRAIT_PHOTOS } from '../consts';
import { url } from '../utils/paths';

interface Props {
	size?: 'lg' | 'sm';
}

const { size = 'lg' } = Astro.props;
const dim = size === 'lg' ? 280 : 160;

const localPhotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/photos/*.{png,jpg,jpeg,webp}',
	{ eager: true },
);

const resolveSrc = (src: string) => {
	if (/^(https?:|\/)/.test(src)) return url(src);
	const match = Object.entries(localPhotos).find(([path]) =>
		path.replace(/\\/g, '/').endsWith(`/${src}`),
	);
	if (!match) {
		throw new Error(`Portrait photo not found: ${src}. Put it in src/assets/photos/.`);
	}
	return match[1].default.src;
};

const photos = PORTRAIT_PHOTOS.map((photo) => ({
	...photo,
	href: resolveSrc(photo.src),
}));
---

<div class:list={['photo-carousel', size]} data-photo-carousel>
	<div class="photo-stage" aria-live="polite">
		{photos.map((photo, i) => (
			<img
				class:list={['photo-slide', { active: i === 0 }]}
				src={photo.href}
				alt={photo.alt}
				width={dim}
				height={dim}
				loading={i === 0 ? 'eager' : 'lazy'}
			/>
		))}
	</div>
	{photos.length > 1 && (
		<div class="photo-dots" role="tablist" aria-label="Portrait photos">
			{photos.map((_, i) => (
				<button
					type="button"
					class:list={['photo-dot', { active: i === 0 }]}
					aria-label={`Show photo ${i + 1}`}
					data-index={String(i)}
				/>
			))}
		</div>
	)}
</div>

<script>
	const INTERVAL_MS = 4500;

	document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach((root) => {
		const slides = Array.from(root.querySelectorAll<HTMLElement>('.photo-slide'));
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.photo-dot'));
		if (slides.length < 2) return;

		let index = 0;
		let timer: ReturnType<typeof setInterval> | undefined;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const show = (next: number) => {
			index = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => slide.classList.toggle('active', i === index));
			dots.forEach((dot, i) => {
				dot.classList.toggle('active', i === index);
				dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
			});
		};

		const stop = () => {
			if (timer) {
				clearInterval(timer);
				timer = undefined;
			}
		};

		const start = () => {
			if (reduceMotion) return;
			stop();
			timer = setInterval(() => show(index + 1), INTERVAL_MS);
		};

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				show(Number(dot.dataset.index));
				start();
			});
		});

		root.addEventListener('mouseenter', stop);
		root.addEventListener('mouseleave', start);
		root.addEventListener('focusin', stop);
		root.addEventListener('focusout', start);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stop();
			else start();
		});

		start();
	});
</script>

<style>
	.photo-carousel {
		--photo-size: 280px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
	}

	.photo-carousel.sm {
		--photo-size: 160px;
	}

	.photo-stage {
		position: relative;
		width: var(--photo-size);
		height: var(--photo-size);
	}

	.photo-slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
		border: 6px solid var(--color-bg);
		box-shadow: 0 0 0 1px var(--color-border), var(--shadow-lg);
		opacity: 0;
		transition: opacity 0.7s ease;
		pointer-events: none;
	}

	.photo-carousel.sm .photo-slide {
		border-width: 4px;
		box-shadow: 0 0 0 1px var(--color-border), var(--shadow-md);
	}

	.photo-slide.active {
		opacity: 1;
		z-index: 1;
	}

	.photo-dots {
		display: flex;
		gap: 0.45rem;
		align-items: center;
	}

	.photo-dot {
		width: 8px;
		height: 8px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-border);
		cursor: pointer;
		transition: transform 0.2s ease, background-color 0.2s ease;
	}

	.photo-dot:hover {
		background: var(--color-text-muted);
	}

	.photo-dot.active {
		background: var(--color-accent);
		transform: scale(1.25);
	}

	@media (max-width: 768px) {
		.photo-carousel.lg {
			--photo-size: 200px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.photo-slide {
			transition: none;
		}
	}
</style>
