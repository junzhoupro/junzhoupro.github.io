---
import AuthorLink from './AuthorLink.astro';
import { url } from '../utils/paths';
import {
  type BibEntry,
  formatAuthor,
  venueLabel,
  isJournal,
  isConference,
  cleanTex,
} from '../utils/bibtex';

interface Props {
  entry: BibEntry;
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const title = cleanTex(entry.fields.title);
const href = entry.fields.url || (entry.fields.doi ? `https://doi.org/${entry.fields.doi}` : '');
const imageSrc = entry.fields.image ? url(entry.fields.image) : '';
---

<article class:list={['publication-item', { compact }]}>
  {imageSrc && !compact && (
    <a class="pub-thumb" href={href || undefined} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined}>
      <img src={imageSrc} alt={title} />
    </a>
  )}
  <div class="pub-body">
    <span class="pub-title">
      {href ? (
        <a href={href} target="_blank" rel="noopener noreferrer">{title}</a>
      ) : (
        title
      )}
    </span>

    <div class="pub-authors">
      <span class="streamline-emojis--busts-in-silhouette" aria-hidden="true"></span>
      {entry.authors.map((auth, i) => (
        <>
          <AuthorLink nameOrSlug={formatAuthor(auth)} />
          {i < entry.authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </div>

    <div class="pub-venue">
      <span class="streamline-emojis--newspaper" aria-hidden="true"></span>
      <span class="venue-name">{venueLabel(entry)}</span>
      {isJournal(entry) && <span class="tag tag-angular tag-lg">Journal</span>}
      {entry.type === 'inproceedings' && !entry.fields.presented && (
        <span class="tag tag-typescript tag-lg">Conference</span>
      )}
    </div>

    {entry.fields.presented && (
      <div class="pub-presented">
        <span class="streamline-emojis--microphone" aria-hidden="true"></span>
        <span class="conference-name" set:html={entry.fields.presented.replace(/EUROGRAPHICS 2022|Computer Graphics and Visual Computing Conference 2022/g, '<b>$&</b>')} />
        <span class="tag tag-typescript tag-lg">Conference</span>
      </div>
    )}

    {entry.fields.funding && (
      <div class="pub-funding">
        <span class="streamline-emojis--money-bag" aria-hidden="true"></span>
        {entry.fields.funding}
      </div>
    )}
  </div>
</article>

<style>
  .publication-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    align-items: start;
  }
  .publication-item.compact {
    display: block;
    grid-template-columns: none;
  }
  .pub-thumb {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-offset);
  }
  .pub-thumb img {
    display: block;
    width: 100%;
    height: 90px;
    object-fit: cover;
  }
  .pub-title {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text-main);
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-serif);
  }
  .pub-title a {
    color: inherit;
    text-decoration: none;
  }
  .pub-title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .pub-authors,
  .pub-venue,
  .pub-presented,
  .pub-funding {
    margin: 0.35rem 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .venue-name {
    font-style: italic;
  }
  .conference-name {
    font-style: normal;
    font-weight: 600;
  }
  .conference-name :global(b) {
    font-weight: 700;
    color: var(--color-text-main);
  }
  @media (max-width: 640px) {
    .publication-item {
      grid-template-columns: 1fr;
    }
    .pub-thumb img {
      height: 160px;
    }
  }
</style>
